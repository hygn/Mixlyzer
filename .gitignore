# Python artifacts
__pycache__/
*.py[cod]
*.pyd
*.so
*.dylib
*.egg-info/
*.egg
*.log
*.npz
# the learned models: the shipped ones (default_*) only; a user's retrained file beside them (the same name without
# default_, npz or json) stays local
assets/weights/*
!assets/weights/default_*
*.zip

# Virtual envs
.venv/
.env/
env/
venv/
.uv/

# IDE/editor
.vscode/
.idea/

# OS cruft
.DS_Store
Thumbs.db

# Build / packaging outputs
dist/
build/*
!build/*.spec
!build/translations.py
!build/audio_engine.py
!build/pipeline_map_svg.py

# Native audio engine: its build (build/audio_engine.py) and the VOLK it builds
audioengine/native/bin/
audioengine/native/target/
audioengine/native/third_party/

# User data / caches (the library folder at the root only: core/library/ is code)
/library/
featurecache/
backups/
debug/
ffmpeg.exe
/ffmpeg
config.json
deck.json
assets/shortcuts/shortcuts.json
assets/midi/midi.json
*.xml
# tests (tests/README.md): the native mixer's checks on the user's tracks and devices stay local; the ground truth's
# audio places are the runner's own
tests/native_mixer/
tests/ground_truth/audio.json
madb_works/

# dataset file (will be splitted into separate repo.)
annotator/
benchmark/

# Local DSP prototypes (not production source)
experiments

# DJ software interchange research (local only)
interchange/

# Local maintenance notes, and their site (mkdocs serve)
docs/internal/
mkdocs.yml
mkdocs.publish.yml
# the web lookups' answers (core.tieup_web)
cache/
