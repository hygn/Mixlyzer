audioengine/native/bin/
audioengine/native/target/
audioengine/native/third_party/

# User data / caches (the library folder at the root only: core/library/ is code)
/library/
featurecache/
backups/
ffmpeg.exe
/ffmpeg
config.json
deck.json
assets/shortcuts/shortcuts.json
assets/midi/midi.json
assets/artists/artist_names.tsv
*.xml
# tests (tests/README.md): the native mixer's checks on the user's tracks and devices stay local; the ground truth's
# audio places are the runner's own
tests/native_mixer/
tests/ground_truth/audio.json

# Algorithm research, this computer only, never the app's code; its results name library tracks, so nothing of it
# goes public. research/
#   benchmark/        the benchmarks, their datasets and every experiment's scripts and results
#                     (fingerprint_research, qbh_research, phrase_boundary, ...)
#   experiments/      prototypes (mix_mode, inhouse_cqt, rekordbox_dragdrop)
#   interchange/      the DJ software interchange research; run from the repository's root:
#                     python -m research.interchange.tools.<tool>
#   debug/            old debug outputs and the analyses' debug visualizations (scripts, their images); the
#                     internal docs' site builds (mkdocs.yml / mkdocs.publish.yml site_dir)
#   madb_works/       the MADB works comparison
#   native_mixer_engine-full-2026-10/   the native mixer checks of the engine before its diet (tag engine-full-2026-10)
research/
annotator/

# Local maintenance notes, and their site (mkdocs serve)
docs/internal/
mkdocs.yml
mkdocs.publish.yml
# the web lookups' answers (core.tieup_web)
cache/
