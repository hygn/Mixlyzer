/* App-wide style sheet, loaded by ui.theme.qss: dollar placeholders are the theme
   tokens (ui.theme.tokens) and glyph paths (ui.theme.icons), filled in on load
   (a literal dollar sign is written twice). Ground rules are in ui/theme/qss.py. */

/* ---------- tooltips, menus ---------- */
QToolTip {
    color: $text;
    background-color: $popup;
    border: 1px solid $border;
    border-radius: ${radius_small}px;
    padding: 4px 6px;
}
QMenu {
    background-color: $popup;
    border: 1px solid $border;
    border-radius: ${radius}px;
    padding: 4px;
}
QMenu::item {
    color: $text;
    padding: 5px 24px 5px 12px;
    border-radius: ${radius_small}px;
}
QMenu::item:selected { background-color: $selection; color: $on_accent; }
QMenu::item:disabled { color: $text_disabled; }
QMenu::separator { height: 1px; background: $separator; margin: 4px 6px; }
QMenuBar { background-color: $window; }
QMenuBar::item { padding: 4px 10px; background: transparent; border-radius: ${radius_small}px; }
QMenuBar::item:selected { background-color: $raised_hover; }

/* ---------- tool bar, status bar ---------- */
QToolBar {
    background-color: $window;
    border: none;
    border-bottom: 1px solid $separator;
    padding: 3px 6px;
    spacing: 2px;
}
QToolBar::separator { width: 1px; background: $separator; margin: 4px 6px; }
QToolBar QToolButton {
    color: $text_dim;
    background: transparent;
    border: none;
    border-radius: ${radius}px;
    padding: 4px 10px;
}
QToolBar QToolButton:hover { color: $text; background-color: $raised; }
QToolBar QToolButton:pressed { background-color: $raised_pressed; }
QStatusBar { background-color: $window; color: $text_dim; border-top: 1px solid $separator; }
QStatusBar::item { border: none; }

/* ---------- buttons ---------- */
QPushButton {
    color: palette(button-text);
    background-color: palette(button);
    border: 1px solid $border;
    border-radius: ${radius}px;
    padding: 3px 12px;
}
QPushButton:hover { background-color: $raised_hover; border-color: $border_strong; }
QPushButton:pressed { background-color: $raised_pressed; }
QPushButton:checked { background-color: $accent_pressed; border-color: $accent; color: $on_accent; }
QPushButton:default { background-color: $accent; border-color: $accent; color: $on_accent; }
QPushButton:default:hover { background-color: $accent_hover; border-color: $accent_hover; }
QPushButton:default:pressed { background-color: $accent_pressed; }
QPushButton:disabled { color: $text_disabled; background-color: $window; border-color: $separator; }
QPushButton:focus { border-color: $accent; }

QToolButton {
    color: palette(button-text);
    background-color: palette(button);
    border: 1px solid $border;
    border-radius: ${radius_small}px;
    padding: 2px 4px;
}
QToolButton:hover { background-color: $raised_hover; border-color: $border_strong; }
QToolButton:pressed { background-color: $raised_pressed; }
QToolButton:checked { background-color: $accent_pressed; border-color: $accent; color: $on_accent; }
QToolButton:disabled { color: $text_disabled; background-color: $window; border-color: $separator; }
QToolButton::menu-indicator { image: none; width: 0; }

/* ---------- text inputs ---------- */
QLineEdit, QPlainTextEdit, QTextEdit {
    color: $text;
    background-color: $base;
    border: 1px solid $border;
    border-radius: ${radius_small}px;
    padding: 2px 6px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
QPlainTextEdit, QTextEdit { padding: 4px; }
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover { border-color: $border_strong; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: $accent; }
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    color: $text_disabled; background-color: $window; border-color: $separator;
}
QLineEdit[readOnly="true"] { color: $text_dim; background-color: $window; }
/* the line edit inside an editable combo / a spin box: the outer widget draws the frame */
QComboBox QLineEdit, QAbstractSpinBox QLineEdit {
    border: none;
    border-radius: 0;
    padding: 0;
    background: transparent;
}

/* ---------- spin boxes ---------- */
QAbstractSpinBox {
    color: $text;
    background-color: $base;
    border: 1px solid $border;
    border-radius: ${radius_small}px;
    padding: 1px 18px 1px 5px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
QAbstractSpinBox:hover { border-color: $border_strong; }
QAbstractSpinBox:focus { border-color: $accent; }
QAbstractSpinBox:disabled { color: $text_disabled; background-color: $window; border-color: $separator; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: ${radius_small}px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: ${radius_small}px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: $raised_hover; }
QAbstractSpinBox::up-arrow { image: url("$chevron_up"); width: 10px; height: 10px; }
QAbstractSpinBox::up-arrow:hover { image: url("$chevron_up_hover"); }
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off { image: url("$chevron_up_disabled"); }
QAbstractSpinBox::down-arrow { image: url("$chevron_down"); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow:hover { image: url("$chevron_down_hover"); }
QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off { image: url("$chevron_down_disabled"); }

/* ---------- combo boxes ---------- */
QComboBox {
    color: palette(button-text);
    background-color: palette(button);
    border: 1px solid $border;
    border-radius: ${radius_small}px;
    padding: 1px 4px 1px 5px;
}
QComboBox:hover { border-color: $border_strong; }
QComboBox:focus, QComboBox:on { border-color: $accent; }
QComboBox:disabled { color: $text_disabled; background-color: $window; border-color: $separator; }
QComboBox:editable { background-color: $base; }
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}
QComboBox::down-arrow { image: url("$chevron_down"); width: 10px; height: 10px; }
QComboBox::down-arrow:hover { image: url("$chevron_down_hover"); }
QComboBox::down-arrow:disabled { image: url("$chevron_down_disabled"); }
QComboBox QAbstractItemView {
    background-color: palette(base);
    border: 1px solid $border;
    outline: 0;
    padding: 2px;
    selection-background-color: $selection;
    selection-color: $on_accent;
}

/* ---------- check boxes, radio buttons ---------- */
QCheckBox, QRadioButton { spacing: 6px; color: $text; background: transparent; }
QCheckBox:disabled, QRadioButton:disabled { color: $text_disabled; }
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
    width: 14px;
    height: 14px;
    background-color: $base;
    border: 1px solid $border_strong;
}
QCheckBox::indicator, QGroupBox::indicator { border-radius: ${radius_small}px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QGroupBox::indicator:hover { border-color: $accent; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background-color: $accent; border-color: $accent; image: url("$check");
}
QCheckBox::indicator:indeterminate { background-color: $accent; border-color: $accent; image: url("$partial"); }
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 $on_accent, stop:0.35 $on_accent, stop:0.45 $accent, stop:1 $accent);
    border-color: $accent;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled, QGroupBox::indicator:disabled {
    background-color: $window; border-color: $separator;
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled { image: url("$check_disabled"); }

/* ---------- group boxes, tabs ---------- */
QGroupBox {
    border: 1px solid $separator;
    border-radius: ${radius}px;
    margin-top: 1.1em;
    padding: 8px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: $text_dim;
}
QTabWidget::pane {
    border: 1px solid $separator;
    border-radius: ${radius}px;
    top: -1px;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    color: $text_dim;
    background: $window;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
}
QTabBar::tab:hover { color: $text; }
QTabBar::tab:selected { color: $text; background: $raised; border-bottom-color: $accent; }
QTabBar::tab:disabled { color: $text_disabled; }

/* ---------- item views ---------- */
QTableView, QTreeView, QListView {
    background-color: $base;
    alternate-background-color: $alt_base;
    border: 1px solid $separator;
    border-radius: ${radius_small}px;
    gridline-color: $separator;
    outline: 0;
}
QHeaderView { background-color: $base; border: none; }
QHeaderView::section {
    color: $text_dim;
    background-color: $base;
    border: none;
    border-right: 1px solid $separator;
    border-bottom: 1px solid $separator;
    padding: 3px 6px;
    font-weight: normal;
}
QHeaderView::section:hover { color: $text; }
QTableCornerButton::section { background-color: $base; border: none; }

/* ---------- scroll bars ---------- */
QScrollBar:vertical { width: ${scrollbar}px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: ${scrollbar}px; background: transparent; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: $border;
    border: 2px solid transparent;
    background-clip: padding;
    border-radius: 4px;
}
QScrollBar::handle:vertical { min-height: 28px; }
QScrollBar::handle:horizontal { min-width: 28px; }
QScrollBar::handle:hover { background-color: $border_strong; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- sliders: thin rail, flat fader cap with a centre line ---------- */
QSlider:horizontal { min-height: 22px; }
QSlider:vertical { min-width: 22px; }
QSlider::groove:horizontal { height: 2px; background: $border; border-radius: 1px; }
QSlider::groove:vertical { width: 2px; background: $border; border-radius: 1px; }
QSlider::sub-page:horizontal { background: $accent; border-radius: 1px; }
/* vertical: the part below the cap (towards the minimum) is filled */
QSlider::add-page:vertical { background: $accent; border-radius: 1px; }
QSlider::handle:vertical {
    height: 8px;
    margin: 0 -10px;
    border: 1px solid #000000;
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a4a4a, stop:0.42 #3a3a3a, stop:0.43 $text, stop:0.57 $text, stop:0.58 #2c2c2c, stop:1 #222222);
}
QSlider::handle:horizontal {
    width: 8px;
    margin: -10px 0;
    border: 1px solid #000000;
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4a4a4a, stop:0.42 #3a3a3a, stop:0.43 $text, stop:0.57 $text, stop:0.58 #2c2c2c, stop:1 #222222);
}
QSlider::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #565656, stop:0.42 #464646, stop:0.43 $accent_hover, stop:0.57 $accent_hover, stop:0.58 #363636, stop:1 #2a2a2a);
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #565656, stop:0.42 #464646, stop:0.43 $accent_hover, stop:0.57 $accent_hover, stop:0.58 #363636, stop:1 #2a2a2a);
}
QSlider::sub-page:horizontal:disabled, QSlider::add-page:vertical:disabled { background: $border_strong; }
QSlider::handle:disabled { background: $raised; border-color: $separator; }

QProgressBar {
    color: $text;
    background-color: $base;
    border: 1px solid $separator;
    border-radius: ${radius_small}px;
    text-align: center;
}
QProgressBar::chunk { background-color: $accent; border-radius: ${radius_small}px; }

/* ---------- splitters ---------- */
QSplitter::handle { background-color: $separator; }
QSplitter::handle:hover { background-color: $accent; }
