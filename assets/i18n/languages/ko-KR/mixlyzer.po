msgstr "플래그로 읽을 바이트의 비트(0-7). 7보다 크면 바이트 전체를 씁니다."

#: ui/config/external_sync.py:74
msgid "Bit position"
msgstr "비트 위치"

#: ui/config/external_sync.py:81
