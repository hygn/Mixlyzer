#: ui/config/analysis.py:64 ui/config/analysis.py:148 ui/reanalyze_dialog.py:39
#: ui/reanalyze_dialog.py:50
msgid "Dynamic Analysis"
msgstr "ダイナミック解析"

#: ui/config/analysis.py:66 ui/reanalyze_dialog.py:41
msgid ""
"Checked: tempo changes within a track (sections, ramps).\n"
"Unchecked: one steady BPM for the whole track."
msgstr ""
"オン: トラック内のテンポ変化 (区間、ランプ) を検出します。\n"
"オフ: トラック全体を一定の BPM 1 つとして扱います。"

#: ui/config/analysis.py:69 ui/reanalyze_dialog.py:44
msgid "Dynamic Downbeat"
msgstr "ダイナミックダウンビート"

#: ui/config/analysis.py:71 ui/reanalyze_dialog.py:46
msgid ""
"Checked: odd bars and meter changes within a track.\n"
"Unchecked: one bar length and downbeat phase for the whole track.\n"
"Always on with Dynamic Analysis."
msgstr ""
"オン: トラック内の端数小節や拍子の変化を検出します。\n"
"オフ: トラック全体で小節の長さとダウンビートの位相を 1 つに固定します。\n"
"ダイナミック解析では常にオンです。"

#: ui/config/analysis.py:150 ui/reanalyze_dialog.py:52
msgid ""
"Key changes within a track. Off: one key for the whole track -- the key "
"the dynamic analysis finds in the intro, outro and interludes (where "
"tracks are mixed), or the key it finds most when a track has none. "
